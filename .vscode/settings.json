{
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "makefile.configureOnOpen": false,
  "files.exclude": {
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/__pycache__": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "app/datasets/**": true,
    "app/history/**": true,
    "appcheckpoints/**": true,
    "site/**": true,
    "wandb/**": true
  }
}
